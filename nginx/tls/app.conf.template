# Production mode: HTTPS with Let's Encrypt. ${MAX_DOMAIN} and ${PUBLIC_WS_URL}
# are filled by the nginx image's envsubst from the container environment.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HTTP: serve ACME challenge, redirect everything else to HTTPS
server {
    listen 80;
    server_name ${MAX_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${MAX_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MAX_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MAX_DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # WebSocket relay -> api.oneme.ru with Origin rewritten (passes the 403 gate)
    location = /websocket {
        proxy_pass                  https://api.oneme.ru/websocket;
        proxy_http_version          1.1;
        proxy_set_header Upgrade     $http_upgrade;
        proxy_set_header Connection  $connection_upgrade;
        proxy_set_header Host        api.oneme.ru;
        proxy_set_header Origin      https://web.max.ru;
        proxy_ssl_server_name       on;
        proxy_read_timeout          3600s;
        proxy_send_timeout          3600s;
    }

    # Branding script (served locally, not proxied)
    location = /__brand.js {
        default_type application/javascript;
        alias /etc/nginx/brand/brand.js;
    }

    # Official client, served transparently; rewrite hardcoded WS URL to ours
    location / {
        proxy_pass                  https://web.max.ru;
        proxy_http_version          1.1;
        proxy_set_header Host        web.max.ru;
        proxy_set_header Accept-Encoding "";
        proxy_ssl_server_name       on;
        proxy_hide_header           Content-Security-Policy;
        proxy_hide_header           Strict-Transport-Security;

        sub_filter_once             off;
        sub_filter_types            application/javascript text/javascript application/json text/html;
        sub_filter "wss://api.oneme.ru/websocket" "${PUBLIC_WS_URL}";
        sub_filter "</head>" "<script src=\"/__brand.js\" defer></script></head>";
    }
}
